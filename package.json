{
  "name": "opencode-holographic",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCode V2 plugin + sidecar that reuses Hermes' holographic SQLite memory store",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "setup": "./install.sh",
    "check": "./sidecar/run.sh --check --verbose",
    "sidecar": "./sidecar/run.sh --verbose"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.28",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
